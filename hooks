const { useState, useRef, useEffect, useCallback } = require('react');
const {
  RTCPeerConnection,
  RTCIceCandidate,
  RTCSessionDescription,
  mediaDevices,
} = require('react-native-webrtc');
const { ref, set, onValue, remove, push, off, onDisconnect } = require('firebase/database');
const { rtdb } = require('../firebase/firebaseConfig');
const { WEBRTC_SIGNAL_PATH } = require('../constants');

/**
 * Serveurs ICE — STUN + TURN publics gratuits
 * Les serveurs TURN sont indispensables sur réseau 4G/hotspot
 * car la connexion P2P directe est souvent bloquée par le NAT opérateur
 */
const ICE_SERVERS = {
  iceServers: [
    // STUN Google (détection IP publique)
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
    // TURN gratuits Open Relay (relay quand P2P direct impossible)
    {
      urls:       'turn:openrelay.metered.ca:80',
      username:   'openrelayproject',
      credential: 'openrelayproject',
    },
    {
      urls:       'turn:openrelay.metered.ca:443',
      username:   'openrelayproject',
      credential: 'openrelayproject',
    },
    {
      urls:       'turn:openrelay.metered.ca:443?transport=tcp',
      username:   'openrelayproject',
      credential: 'openrelayproject',
    },
  ],
};

/* ═══════════════════════════════════════════════════════
   CÔTÉ PROPRIO — reçoit le flux de la tablette vendeur
═══════════════════════════════════════════════════════ */
const useWebRTCViewer = (cartId) => {
  const [remoteStream, setRemoteStream] = useState(null);
  const [connected,    setConnected]    = useState(false);
  const [connecting,   setConnecting]   = useState(false);
  const [error,        setError]        = useState(null);
  const pcRef          = useRef(null);
  const cleanupRef     = useRef([]);

  const cleanup = useCallback(() => {
    cleanupRef.current.forEach(fn => { try { fn(); } catch(_) {} });
    cleanupRef.current = [];
    if (pcRef.current) {
      pcRef.current.close();
      pcRef.current = null;
    }
    setRemoteStream(null);
    setConnected(false);
    setConnecting(false);
    setError(null);
  }, []);

  const connect = useCallback(async () => {
    if (!cartId) { setError('Aucun cartId configuré'); return; }
    cleanup();
    setConnecting(true);
    setError(null);

    try {
      const pc = new RTCPeerConnection(ICE_SERVERS);
      pcRef.current = pc;

      pc.ontrack = (event) => {
        const stream = event.streams?.[0];
        if (stream) {
          setRemoteStream(stream);
          setConnected(true);
          setConnecting(false);
        }
      };

      pc.oniceconnectionstatechange = () => {
        const state = pc.iceConnectionState;
        console.log('[WebRTC Viewer] ICE state:', state);
        if (state === 'connected' || state === 'completed') {
          setConnected(true);
          setConnecting(false);
        }
        if (state === 'failed') {
          setError('Connexion ICE échouée — vérifiez la connexion internet');
          setConnected(false);
          setConnecting(false);
        }
        if (state === 'disconnected') {
          setConnected(false);
        }
      };

      // Envoyer nos ICE candidates à la tablette
      pc.onicecandidate = (event) => {
        if (event.candidate) {
          push(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/viewer-candidates`), {
            candidate: event.candidate.toJSON(),
          });
        }
      };

      // Écouter l'offre SDP de la tablette
      const offerRef = ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/offer`);
      const offerUnsub = onValue(offerRef, async (snap) => {
        const offer = snap.val();
        if (!offer || pc.currentRemoteDescription) return;
        try {
          await pc.setRemoteDescription(new RTCSessionDescription(offer));
          const answer = await pc.createAnswer();
          await pc.setLocalDescription(answer);
          await set(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/answer`), {
            type: answer.type,
            sdp:  answer.sdp,
          });
        } catch (e) {
          console.error('[WebRTC Viewer] setRemoteDescription:', e.message);
          setError(e.message);
          setConnecting(false);
        }
      });
      cleanupRef.current.push(() => off(offerRef));

      // Écouter les ICE candidates de la tablette
      const hostCandRef = ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/host-candidates`);
      const hostCandUnsub = onValue(hostCandRef, (snap) => {
        const candidates = snap.val();
        if (!candidates || !pc.remoteDescription) return;
        Object.values(candidates).forEach(async (c) => {
          try {
            await pc.addIceCandidate(new RTCIceCandidate(c.candidate));
          } catch (e) {
            console.warn('[WebRTC Viewer] addIceCandidate:', e.message);
          }
        });
      });
      cleanupRef.current.push(() => off(hostCandRef));

    } catch (e) {
      console.error('[WebRTC Viewer] connect error:', e.message);
      setError(e.message);
      setConnecting(false);
    }
  }, [cartId]);

  const disconnect = useCallback(() => {
    cleanup();
    if (cartId) remove(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/answer`));
  }, [cartId]);

  useEffect(() => () => cleanup(), []);

  return { remoteStream, connected, connecting, error, connect, disconnect };
};

/* ═══════════════════════════════════════════════════════
   CÔTÉ TABLETTE VENDEUR — diffuse la caméra en arrière-plan
   La caméra est capturée mais AUCUN aperçu n'est affiché
═══════════════════════════════════════════════════════ */
const useWebRTCBroadcaster = (cartId) => {
  const [broadcasting, setBroadcasting] = useState(false);
  const [error,        setError]        = useState(null);
  const pcRef          = useRef(null);
  const localStreamRef = useRef(null);
  const cleanupRef     = useRef([]);

  const stopBroadcast = useCallback(() => {
    cleanupRef.current.forEach(fn => { try { fn(); } catch(_) {} });
    cleanupRef.current = [];

    if (localStreamRef.current) {
      localStreamRef.current.getTracks().forEach(t => t.stop());
      localStreamRef.current = null;
    }
    if (pcRef.current) {
      pcRef.current.close();
      pcRef.current = null;
    }
    if (cartId) remove(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}`));
    setBroadcasting(false);
    setError(null);
  }, [cartId]);

  const startBroadcast = useCallback(async () => {
    if (!cartId) return;
    stopBroadcast();
    setError(null);

    try {
      // Demander permissions caméra + micro
      const stream = await mediaDevices.getUserMedia({
        audio: true,
        video: {
          facingMode:  'environment',  // caméra arrière
          width:       { ideal: 1280 },
          height:      { ideal: 720 },
          frameRate:   { ideal: 24 },
        },
      });
      localStreamRef.current = stream;

      const pc = new RTCPeerConnection(ICE_SERVERS);
      pcRef.current = pc;

      // Ajouter les pistes au peer connection
      stream.getTracks().forEach(track => pc.addTrack(track, stream));

      pc.oniceconnectionstatechange = () => {
        console.log('[WebRTC Broadcaster] ICE state:', pc.iceConnectionState);
        if (pc.iceConnectionState === 'connected' ||
            pc.iceConnectionState === 'completed') {
          setBroadcasting(true);
        }
        if (pc.iceConnectionState === 'failed') {
          setError('Connexion ICE échouée');
          setBroadcasting(false);
        }
      };

      // Envoyer nos ICE candidates au proprio
      pc.onicecandidate = (event) => {
        if (event.candidate) {
          push(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/host-candidates`), {
            candidate: event.candidate.toJSON(),
          });
        }
      };

      // Créer et publier l'offre SDP
      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      await set(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/offer`), {
        type: offer.type,
        sdp:  offer.sdp,
      });

      // Nettoyage automatique côté serveur si la tablette perd la connexion
      // (app tuée, wifi coupé, batterie morte) — évite un statut "en ligne" fantôme
      // affiché dans l'app proprio alors que le cart est réellement hors-ligne.
      onDisconnect(ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}`)).remove();

      // Écouter la réponse du proprio
      const answerRef = ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/answer`);
      onValue(answerRef, async (snap) => {
        const answer = snap.val();
        if (!answer || pc.currentRemoteDescription) return;
        try {
          await pc.setRemoteDescription(new RTCSessionDescription(answer));
        } catch (e) {
          console.error('[WebRTC Broadcaster] setRemoteDescription:', e.message);
          setError(e.message);
        }
      });
      cleanupRef.current.push(() => off(answerRef));

      // Écouter les ICE candidates du proprio
      const viewerCandRef = ref(rtdb, `${WEBRTC_SIGNAL_PATH}/${cartId}/viewer-candidates`);
      onValue(viewerCandRef, (snap) => {
        const candidates = snap.val();
        if (!candidates || !pc.remoteDescription) return;
        Object.values(candidates).forEach(async (c) => {
          try {
            await pc.addIceCandidate(new RTCIceCandidate(c.candidate));
          } catch (e) {
            console.warn('[WebRTC Broadcaster] addIceCandidate:', e.message);
          }
        });
      });
      cleanupRef.current.push(() => off(viewerCandRef));

    } catch (e) {
      console.error('[WebRTC Broadcaster] startBroadcast:', e.message);
      setError(e.message);
      setBroadcasting(false);
    }
  }, [cartId]);

  useEffect(() => () => stopBroadcast(), []);

  return { broadcasting, error, startBroadcast, stopBroadcast };
};

module.exports = { useWebRTCViewer, useWebRTCBroadcaster };
